{
  "name": "echo-open",
  "productName": "Echo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, bring-your-own-keys desktop overlay that transcribes mic + system audio (Groq Whisper) and suggests answers (Google Gemini) during interviews and meetings.",
  "license": "MIT",
  "author": "conoorsheedy-oss",
  "repository": {
    "type": "git",
    "url": "https://github.com/conoorsheedy-oss/Echo.git"
  },
  "bugs": {
    "url": "https://github.com/conoorsheedy-oss/Echo/issues"
  },
  "keywords": [
    "electron",
    "overlay",
    "transcription",
    "whisper",
    "groq",
    "gemini",
    "meeting-assistant",
    "interview-practice"
  ],
  "main": "src/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/gesture-core.test.js test/ai-answers.test.js",
    "gestures:fetch": "node scripts/fetch-gesture-assets.js",
    "postinstall": "node scripts/fetch-gesture-assets.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "devDependencies": {
    "electron": "^31.7.7"
  }
}
