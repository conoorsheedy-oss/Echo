# Optional developer fallback. Most people should paste their keys into the
# app instead (⋯ menu > API keys), where they're encrypted with the OS keychain.
# Copy this file to ".env" (next to package.json). Keys saved in the app win.
# .env is git-ignored -- never commit real keys.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: only for Settings > Speech-to-text > Deepgram Nova-3 (live).
# $200 free credit, no card: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# Optional model overrides (defaults shown). Google retires older Flash
# models over time; if answers say the model is unknown, set GEMINI_MODEL to
# a current Gemini Flash model id from Google AI Studio.
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.5-flash
# Deepgram live model and language ("multi" = Nova-3 multilingual).
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
